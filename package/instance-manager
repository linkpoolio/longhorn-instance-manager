#!/bin/bash

function show_help() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
    -s, --enable-spdk          Enable SPDK
        --spdk-interrupt-mode  Enable SPDK interrupt mode
        --spdk-memory-size     SPDK memory size in MB
        --spdk-cpumask         SPDK CPU mask
        --spdk-no-hugepage     Disable SPDK hugepage usage
    -l, --spdk-log             SPDK log level
    -h, --help                 Show this help message and exit
EOF
    exit 0
}

function bind_dev() {
    mount --rbind /host/dev /dev
}

function bind_sys() {
    mount --rbind /host/sys /sys
}

function bind_lib_modules() {
    mount --rbind /host/lib/modules /lib/modules
}

function enable_tgtd() {
    echo "Enabling tgtd"
    tgtd -f 2>&1 | tee /var/log/tgtd.log &
}

function generate_nvme_hostid_and_hostnqn() {
    mkdir -p /etc/nvme

    local hostnqn=$(nvme gen-hostnqn)
    # hostnqn is generated from /sys/class/dmi/id/product_uuid according to the implementation of libnvme
    echo "$hostnqn" > /etc/nvme/hostnqn
    # Always generate the same hostid for the same hostnqn
    cat /sys/class/dmi/id/product_uuid > /etc/nvme/hostid
}

function enable_spdk_tgt() {
    local options=("$@")
    # Containerd spawns privileged containers with RLIMIT_MEMLOCK hard=8 MiB.
    # SPDK pins hugepage ranges as RDMA Memory Regions; with an 8 MiB cap it
    # can only register a sliver of the --mem-size pool and every IO whose
    # buffer lands outside the window serializes through a bounce buffer,
    # observed as ~400 ms per 128 KiB op on RDMA. The privileged container
    # already holds CAP_SYS_RESOURCE, so prlimit on our own shell raises the
    # hard cap to unlimited; spdk_tgt inherits it.
    prlimit --pid $$ --memlock=unlimited:unlimited 2>/dev/null || true
    # Crash forensics: spdk_tgt has died by unhandled signal with no output
    # under mass TCP reconnect storms (suspected nvme_tcp teardown
    # use-after-free). The node's kernel.core_pattern is the plain relative
    # "core", so a dump lands in the process cwd -- launch from /log (the
    # hostPath that survives pod replacement) instead of /, and pin the core
    # rlimit so a backtrace is available the next time it dies. Hugepage
    # ranges are excluded from dumps by the default coredump_filter, so the
    # core stays heap+stacks sized.
    prlimit --pid $$ --core=unlimited:unlimited 2>/dev/null || true
    # --wait-for-rpc keeps spdk_tgt paused before subsystem initialisation so
    # that the Go side can call iobuf_set_options / bdev_nvme_set_options /
    # nvmf_create_transport with tuned opts; then it drives framework_start_init
    # to complete boot. Without this the default iobuf pools (large=1024,
    # small=8192) lock in before we can grow them and any tuned transport
    # opts exceed the pool, failing accel/bdev channel creation with -ENOMEM.
    options+=("--wait-for-rpc")
    echo "Enabling spdk_tgt with options: ${options[*]}"
    (cd /log && spdk_tgt "${options[@]}" 2>&1 | tee -a /log/spdk_tgt.log) &

    timeout=120  # Timeout in seconds
    interval=1  # Interval in seconds
    elapsed_time=0

    while [ $elapsed_time -lt $timeout ]; do
        if [ -S "/var/tmp/spdk.sock" ]; then
            echo "Socket file '/var/tmp/spdk.sock' found after $elapsed_time seconds."
            return 0  # Exit successfully if the file exists
        fi

        sleep $interval
        elapsed_time=$((elapsed_time + interval))
    done

    echo "Timeout reached. Socket file '/var/tmp/spdk.sock' not found."
    return 1
}

function watch_spdk_tgt() {
    local instance_manager_pid="$1"

    while kill -0 "$instance_manager_pid" >/dev/null 2>&1; do
        if ! pgrep -f '(^|/)spdk_tgt([[:space:]]|$)' >/dev/null 2>&1; then
            echo "spdk_tgt is not running; terminating longhorn-instance-manager"
            kill -TERM "$instance_manager_pid" >/dev/null 2>&1 || true
            sleep 10
            kill -KILL "$instance_manager_pid" >/dev/null 2>&1 || true
            return
        fi
        sleep 1
    done
}

function forward_signal() {
    local signal="$1"

    if [[ -n "${instance_manager_pid:-}" ]] && kill -0 "$instance_manager_pid" >/dev/null 2>&1; then
        echo "Forwarding $signal to longhorn-instance-manager"
        kill "-$signal" "$instance_manager_pid" >/dev/null 2>&1 || true
    fi
}

enable_spdk=0
spdk_options=()
instance_manager_options=()
instance_manager_pid=""

while [[ $# -gt 0 ]]; do
    opt="$1"
    case $opt in
        -s|--enable-spdk)
            enable_spdk=1
            ;;
        -m|--spdk-cpumask)
            spdk_options+=("-m" "$2")
            # Export so the IM Go process can derive accel_mlx5 num_requests
            # from the actual SPDK core count (not runtime.NumCPU(), which
            # returns the pod's cgroup-visible CPUs and can mismatch).
            export LONGHORN_V2_SPDK_CPUMASK="$2"
            shift
            ;;
        -s|--spdk-memory-size)
            spdk_options+=("--mem-size" "$2")
            shift
            ;;
        -g|--spdk-no-hugepage)
            spdk_options+=("--no-huge")
            ;;
        -l|--spdk-log)
            spdk_options+=("-L" "$2")
            shift
            ;;
        --spdk-interrupt-mode)
            spdk_options+=("--interrupt-mode")
            ;;
        -h|--help)
            show_help
            ;;
        *)
            instance_manager_options+=("$1")
            ;;
    esac
    shift
done

#### Main ####

if [ "$enable_spdk" -eq 1 ]; then
    mkdir -p /log
    touch /log/instance-manager-${DATA_ENGINE}.log
    touch /log/spdk_tgt.log
fi

bind_dev
bind_sys
bind_lib_modules
[ "$enable_spdk" -eq 0 ] && enable_tgtd
[ "$enable_spdk" -eq 1 ] && generate_nvme_hostid_and_hostnqn
[ "$enable_spdk" -eq 1 ] && enable_spdk_tgt "${spdk_options[@]}"

if [ "$enable_spdk" -eq 1 ]; then
    exec-logrotate
    trap 'forward_signal TERM' TERM
    trap 'forward_signal INT' INT

    log_fifo=$(mktemp -u /tmp/longhorn-instance-manager-log.XXXXXX)
    mkfifo "$log_fifo"
    tee -a /log/instance-manager-${DATA_ENGINE}.log < "$log_fifo" &
    log_tee_pid=$!

    longhorn-instance-manager "${instance_manager_options[@]}" > "$log_fifo" 2>&1 &
    instance_manager_pid=$!
    watch_spdk_tgt "$instance_manager_pid" &
    spdk_watchdog_pid=$!

    wait "$instance_manager_pid"
    instance_manager_status=$?

    kill "$spdk_watchdog_pid" >/dev/null 2>&1 || true
    wait "$spdk_watchdog_pid" >/dev/null 2>&1 || true
    wait "$log_tee_pid" >/dev/null 2>&1 || true
    rm -f "$log_fifo"
    exit "$instance_manager_status"
else
    exec longhorn-instance-manager "${instance_manager_options[@]}"
fi
