#!/bin/bash

# kubelet runs PreStop as an exec with its own stdout/stderr — log shippers
# only tail the container's PID 1 stdout. Join the main log stream, but guard
# the redirect: a failed exec would abort the script and skip the shutdown.
if [ -w /proc/1/fd/1 ]; then
    exec >> /proc/1/fd/1 2>&1
fi

log() {
    echo "[prestop] $(date '+%Y-%m-%d %H:%M:%S.%N') $*"
}

# The wrapper launches spdk_tgt by bare name, so its /proc cmdline starts
# with "spdk_tgt" (the image has no pidof).
spdk_tgt_is_running() {
    pgrep -f "^spdk_tgt" > /dev/null 2>&1
}

if ! spdk_tgt_is_running; then
    log "spdk_tgt is not running; nothing to shut down"
    exit 0
fi

log "Sending SIGTERM to go-spdk-helper to stop spdk_tgt..."
if go-spdk-helper kill-instance --sig-name SIGTERM; then
    log "Successfully sent SIGTERM to spdk_tgt"
else
    log "Failed to send SIGTERM via go-spdk-helper"
fi

# Wait for spdk_tgt to exit: on SIGTERM it flushes the blobstore, and cutting
# that short costs a 15-30 min recovery on next boot. Pod grace is 300s; wait
# up to 270s and leave escalation at grace expiry to the kubelet.
grace_period=270
elapsed=0
while [[ $elapsed -lt $grace_period ]]; do
    if ! spdk_tgt_is_running; then
        log "spdk_tgt exited after ${elapsed}s"
        exit 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

log "spdk_tgt still running after ${grace_period}s; leaving it to the kubelet"
