#!/bin/bash

# kubelet runs PreStop as an exec against the container with its own
# stdout/stderr — log shippers typically only tail the container's PID 1
# stdout (/var/log/pods/<pod>/<ctr>/0.log). Redirect this script's output
# to PID 1's fd 1 so the graceful-shutdown trace joins the container's
# main log stream rather than being lost when the pod terminates.
# Guard the redirect: if PID 1's fd 1 isn't writable (e.g. unusual runtime
# sandboxing), a failed exec would abort the whole script and skip the
# graceful shutdown below — better to lose the logs than the drain.
if [ -w /proc/1/fd/1 ]; then
    exec >> /proc/1/fd/1 2>&1
fi

log() {
    echo "[prestop] $(date -u '+%Y-%m-%dT%H:%M:%S.%NZ') $*"
}

SPDK_TGT_PID_FILE="/var/run/longhorn-spdk-tgt.pid"

process_is_running() {
    local pid="$1"
    local stat
    local state

    [[ -n "$pid" ]] || return 1
    kill -0 "$pid" >/dev/null 2>&1 || return 1

    stat=$(<"/proc/$pid/stat") || return 1
    state="${stat#*) }"
    state="${state%% *}"
    [[ "$state" != "Z" ]]
}

process_argv0_is() {
    local pid="$1"
    local expected="$2"
    local argv0

    [[ -r "/proc/$pid/cmdline" ]] || return 1
    IFS= read -r -d '' argv0 < "/proc/$pid/cmdline" || true
    argv0="${argv0##*/}"
    [[ "$argv0" == "$expected" ]]
}

spdk_tgt_pid_is_running() {
    local pid="$1"

    process_is_running "$pid" && process_argv0_is "$pid" "spdk_tgt"
}

get_spdk_tgt_pids() {
    local pid
    local proc

    if [[ -r "$SPDK_TGT_PID_FILE" ]]; then
        read -r pid < "$SPDK_TGT_PID_FILE" || true
        if spdk_tgt_pid_is_running "$pid"; then
            echo "$pid"
            return
        fi
    fi

    for proc in /proc/[0-9]*; do
        pid="${proc##*/}"
        if spdk_tgt_pid_is_running "$pid"; then
            echo "$pid"
        fi
    done
}

spdk_tgt_is_running() {
    [[ -n "$(get_spdk_tgt_pids)" ]]
}

function cleanup_spdk_resources() {
    log "Caught termination signal. Cleaning up SPDK resources..."

    if ! spdk_tgt_is_running; then
        # spdk_tgt has already exited or crashed. Its NVMe-oF target is gone,
        # so any dm device still mapping a /dev/longhorn volume onto that target
        # has in-flight I/O parked in uninterruptible D-state. That wedged
        # kernel I/O defeats the container's final SIGKILL, so the pod hangs in
        # Terminating forever. Force-fail the dm devices so the pod can be reaped.
        log "spdk_tgt is not running (crashed/exited); force-failing stale dm devices so stuck I/O is released and the pod can be reaped"
        local dead_devices=($(get_v2_devices))
        for device in "${dead_devices[@]}"; do
            if timeout 10 dmsetup remove --force "$device"; then
                log "Force-removed stale device-mapper device: $device"
            else
                log "Failed to force-remove device-mapper device (relying on SIGKILL): $device"
            fi
            rm -f "/host/dev/longhorn/$device"
        done
        return
    fi

    # 1. Send SIGTERM to spdk_tgt so it flushes its blobstore and exits cleanly.
    #    The process's sockets are closed by the kernel as it exits;
    #    ctrlr_loss_timeout on the peer bdev_nvme controllers handles the
    #    reconnect. Do NOT drain the NVMf listeners explicitly first: each
    #    listener removal force-disconnects every connected qpair
    #    (spdk_nvmf_transport_stop_listen_async), so draining a storage node
    #    disconnects every peer initiator at once while the lvstore is still
    #    tearing down, faulting every dependent raid bdev simultaneously and
    #    triggering a kernel-initiator reconnect storm on the engine targets
    #    that wedges the peer SPDK reactors.
    log "Sending SIGTERM to go-spdk-helper to stop spdk_tgt..."
    timeout 10 go-spdk-helper kill-instance --sig-name SIGTERM
    if [[ $? -ne 0 ]]; then
        log "Failed to send SIGTERM to go-spdk-helper"
    else
        log "Successfully sent SIGTERM to go-spdk-helper"
    fi

    # 2. Wait for spdk_tgt to exit. A healthy shutdown flushes its blobstore and
    #    exits within seconds. If wedged, SIGKILL after a bounded grace.
    local grace_sec="${SPDK_TGT_SHUTDOWN_GRACE_SEC:-30}"
    local deadline=$(( $(date +%s) + grace_sec ))
    while spdk_tgt_is_running; do
        if [[ $(date +%s) -ge ${deadline} ]]; then
            log "spdk_tgt did not exit within ${grace_sec}s of SIGTERM (wedged shutdown); escalating to SIGKILL so the pod is reaped now"
            local pid
            for pid in $(get_spdk_tgt_pids); do
                if kill -9 "$pid" 2>/dev/null; then
                    log "SIGKILLed wedged spdk_tgt pid ${pid}"
                fi
            done
            sleep 1
            local device
            local stale_devices=($(get_v2_devices))
            for device in "${stale_devices[@]}"; do
                if timeout 10 dmsetup remove --force "$device"; then
                    log "Force-removed stale device-mapper device after SIGKILL: $device"
                else
                    log "Failed to force-remove device-mapper device after SIGKILL (relying on container SIGKILL): $device"
                fi
                rm -f "/host/dev/longhorn/$device"
            done
            return
        fi
        sleep 1
    done
    log "spdk_tgt exited cleanly after SIGTERM"

    # 3. Now that spdk_tgt is gone, remove dm devices. At this point the block
    #    devices are no longer held open by spdk_tgt, so dmsetup remove should
    #    succeed cleanly.
    local v2_devices=($(get_v2_devices))
    for device in "${v2_devices[@]}"; do
        if timeout 10 dmsetup remove "$device"; then
            log "Removed device-mapper device: $device"
        else
            log "Failed to remove device-mapper device (busy or timed out): $device"
        fi

        device_file="/host/dev/longhorn/$device"
        if rm -f "$device_file"; then
            log "Removed device file: $device_file"
        else
            log "Failed to remove device file: $device_file"
        fi
    done
}

function get_v2_devices() {
    # dmsetup ls prints "name<TAB>(major:minor)" per device, but emits the
    # literal string "No devices found" on stdout when the table is empty —
    # filter to lines whose second field looks like a "(maj:min)" entry so
    # that string is never treated as a device name.
    local dm_devices
    dm_devices=$(dmsetup ls 2>/dev/null | awk 'NF>1 && $2 ~ /^\(/ {print $1}')
    local v2_devices=()

    if [[ ! -d /host/dev/longhorn/ ]]; then
        echo "${v2_devices[@]}"
        return
    fi

    local device_files
    device_files=$(ls /host/dev/longhorn/)

    for dm_device in $dm_devices; do
        for device_file in $device_files; do
            if [[ "$dm_device" == "$device_file" ]]; then
                v2_devices+=("$dm_device")
                break
            fi
        done
    done

    echo "${v2_devices[@]}"
}

cleanup_spdk_resources
